{
  "name": "whatsapp-automation-desktop",
  "version": "1.0.0",
  "description": "WhatsApp Automation Desktop App with Authentication & Subscriptions",
  "main": "src/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-all.js",
    "start": "node scripts/start-all.js",
    "dev:backend": "node src/main/server.js",
    "dev:client": "vite",
    "dev:electron": "node scripts/run-electron.js",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "browserslist": "^4.28.2",
    "caniuse-lite": "^1.0.30001787",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.8.3",
    "express": "^4.18.2",
    "framer-motion": "^10.16.16",
    "fs-extra": "^11.3.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.303.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "nedb-promises": "^6.2.3",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "sqlite3": "^6.0.1",
    "uuid": "^9.0.1",
    "whatsapp-web.js": "^1.34.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.10"
  },
  "build": {
    "appId": "com.whatsapp.automation",
    "productName": "WhatsAppAutomation",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/renderer/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
